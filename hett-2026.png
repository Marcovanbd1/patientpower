<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mark Winterburn — Founder: CoLab Lens</title>
<meta name="description" content="Mark Winterburn — Founder: CoLab Lens. Solving machine to human communication by 2030. NHS Primary Care, Neighbourhood Health, Applied Philosopher.">

<!-- Open Graph / LinkedIn preview card -->
<meta property="og:type" content="profile">
<meta property="og:site_name" content="markwinterburn.uk">
<meta property="og:title" content="Mark Winterburn — Founder: CoLab Lens">
<meta property="og:description" content="Solving machine to human communication by 2030. Built inside the NHS, proven at HETT 2026.">
<meta property="og:url" content="https://markwinterburn.uk/">
<meta property="og:image" content="https://markwinterburn.uk/og-card.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<!-- Twitter/X card (falls back to OG tags above if omitted, but explicit is safer) -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Mark Winterburn — Founder: CoLab Lens">
<meta name="twitter:description" content="Solving machine to human communication by 2030. Built inside the NHS, proven at HETT 2026.">
<meta name="twitter:image" content="https://markwinterburn.uk/og-card.jpg">

<link rel="canonical" href="https://markwinterburn.uk/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0b0d0f;
    --panel:#14171a;
    --panel-2:#181c1f;
    --text:#e8e6df;
    --text-dim:#9a9d9c;
    --text-faint:#5f6362;
    --tally:#e1362c;
    --amber:#e8a33d;
    --teal:#3fa9a0;
    --hairline:#262a2d;
    --lens-blue:#6e93c4;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --serif: 'Source Serif 4', Georgia, serif;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:var(--serif);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a{color:var(--teal);}
  a:hover{color:var(--amber);}
  a:focus-visible, button:focus-visible{
    outline:2px solid var(--amber);
    outline-offset:3px;
  }

  .bars{
    display:flex;
    width:100%;
    height:5px;
  }
  .bars span{flex:1;}
  .bars span:nth-child(1){background:#e8e6df;}
  .bars span:nth-child(2){background:#e8a33d;}
  .bars span:nth-child(3){background:#3fa9a0;}
  .bars span:nth-child(4){background:#5f9e4c;}
  .bars span:nth-child(5){background:#b060b8;}
  .bars span:nth-child(6){background:#e1362c;}
  .bars span:nth-child(7){background:#2a5fa8;}

  .wrap{
    max-width:640px;
    margin:0 auto;
    padding:0 24px;
  }

  header.slate{
    padding:56px 0 40px;
  }

  .header-row{
    display:flex;
    align-items:flex-start;
    gap:20px;
    margin-bottom:22px;
  }

  .cam{
    position:relative;
    width:132px;
    height:165px;
    aspect-ratio:4/5;
    flex-shrink:0;
    border:1px solid var(--hairline);
    background:var(--panel);
  }
  .cam img{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center 22%;
    filter:saturate(0.9);
  }
  .cam .bracket{
    position:absolute;
    width:14px;height:14px;
    border-color:var(--amber);
    border-style:solid;
    border-width:0;
    opacity:0.85;
  }
  .cam .bracket.tl{top:-1px;left:-1px;border-top-width:2px;border-left-width:2px;}
  .cam .bracket.tr{top:-1px;right:-1px;border-top-width:2px;border-right-width:2px;}
  .cam .bracket.bl{bottom:-1px;left:-1px;border-bottom-width:2px;border-left-width:2px;}
  .cam .bracket.br{bottom:-1px;right:-1px;border-bottom-width:2px;border-right-width:2px;}
  .cam .tag-label{
    position:absolute;
    top:6px;left:6px;
    display:flex;
    align-items:center;
    gap:5px;
    font-family:var(--mono);
    font-size:10px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--text);
    background:rgba(11,13,15,0.55);
    padding:3px 6px;
  }
  .cam .tag-label .dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--tally);
    box-shadow:0 0 4px 1px rgba(225,54,44,0.7);
  }

  .lens-strip{
    flex:1;
    min-width:0;
    height:165px;
    position:relative;
  }
  .strip-line{
    position:absolute;
    left:0; right:0; top:50%;
    height:1px;
    background:var(--hairline);
    transform:translateY(-50%);
  }
  .strip-dots{
    position:absolute;
    left:0; right:0; top:50%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    transform:translateY(-50%);
  }
  .strip-dot{
    width:8px; height:8px;
    border-radius:50%;
    background:var(--text-faint);
  }
  .strip-dot.active{
    background:var(--lens-blue);
    box-shadow:0 0 6px 1px rgba(110,147,196,0.65);
  }
  .strip-caps{
    position:absolute;
    left:0; right:0;
    top:calc(50% + 14px);
    display:flex;
    justify-content:space-between;
  }
  .strip-cap{
    font-family:var(--mono);
    font-size:9.5px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--text-faint);
    white-space:nowrap;
  }
  .strip-cap.active{
    color:var(--lens-blue);
  }
  .strip-cap:first-child{ text-align:left; }
  .strip-cap:last-child{ text-align:right; }

  @media (max-width:380px){
    .strip-cap{
      font-size:8px;
      letter-spacing:0.06em;
    }
    .strip-caps{
      top:calc(50% + 12px);
    }
  }

  .ident{
    display:flex;
    align-items:center;
    gap:10px;
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--text-dim);
  }
  .tally{
    width:8px;height:8px;border-radius:50%;
    background:var(--tally);
    box-shadow:0 0 6px 1px rgba(225,54,44,0.7);
    animation:pulse 2.6s ease-in-out infinite;
    flex-shrink:0;
  }
  @media (prefers-reduced-motion: reduce){
    .tally{animation:none;}
  }
  @keyframes pulse{
    0%,100%{opacity:1;}
    50%{opacity:0.45;}
  }
  .timecode{margin-left:auto; color:var(--text-faint);}

  .name{
    font-family:var(--mono);
    font-size:15px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--text-dim);
    margin:22px 0 6px;
  }

  h1.headline{
    font-family:var(--mono);
    font-weight:600;
    font-size:clamp(30px, 8vw, 46px);
    letter-spacing:0.02em;
    margin:8px 0 18px;
    line-height:1.15;
    word-break:normal;
    overflow-wrap:break-word;
  }

  .pivot{
    font-family:var(--serif);
    font-size:18px;
    color:var(--text-dim);
    max-width:46ch;
  }
  .pivot strong{color:var(--text); font-weight:600;}

  .scroll-cue{
    margin-top:32px;
  }
  .scroll-arrow{
    display:inline-block;
    font-family:var(--mono);
    font-size:18px;
    color:var(--text-faint);
    opacity:0.4;
    animation:scrollBob 2.6s ease-in-out infinite;
  }
  @keyframes scrollBob{
    0%,100%{ transform:translateY(0); opacity:0.3; }
    50%{ transform:translateY(6px); opacity:0.65; }
  }
  @media (prefers-reduced-motion: reduce){
    .scroll-arrow{ animation:none; opacity:0.4; }
  }

  .cue{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--amber);
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:16px;
  }
  .cue::before{
    content:"";
    width:20px;height:1px;
    background:var(--amber);
    opacity:0.6;
  }

  section{
    padding:44px 0;
    border-top:1px solid var(--hairline);
  }

  .moonshot{
    padding:28px 24px;
    background:var(--panel);
    border:1px solid var(--hairline);
    border-left:3px solid var(--tally);
  }
  .moonshot .label{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--text-faint);
    margin-bottom:10px;
  }
  .moonshot .statement{
    font-family:var(--serif);
    font-weight:600;
    font-size:clamp(22px, 5.4vw, 30px);
    line-height:1.3;
    color:var(--text);
    margin:0 0 12px;
  }
  .moonshot .sub{
    font-family:var(--mono);
    font-size:13px;
    color:var(--text-dim);
    margin:0;
  }

  .tags{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin:0 0 20px;
  }
  .tag{
    font-family:var(--mono);
    font-size:11.5px;
    letter-spacing:0.04em;
    padding:5px 10px;
    border:1px solid var(--hairline);
    border-radius:2px;
    color:var(--text-dim);
    background:var(--panel);
  }
  .tag.op{color:var(--amber); border-color:rgba(232,163,61,0.35);}

  .bio p{
    font-size:17px;
    color:var(--text);
    margin:0 0 14px;
  }
  .bio p.dim{color:var(--text-dim);}

  .dims{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin:20px 0 0;
  }
  .dim{
    font-family:var(--mono);
    font-size:11.5px;
    letter-spacing:0.04em;
    padding:6px 10px;
    border:1px solid var(--hairline);
    color:var(--teal);
    background:var(--panel);
  }

  .questions{
    list-style:none;
    margin:0;
    padding:0;
  }
  .questions li{
    font-family:var(--serif);
    font-style:italic;
    font-size:18px;
    color:var(--text);
    padding:16px 0;
    border-top:1px solid var(--hairline);
  }
  .questions li:first-child{border-top:none; padding-top:0;}

  .steps{
    display:flex;
    flex-direction:column;
    gap:0;
    margin-top:8px;
  }
  .step-row{
    display:flex;
    gap:18px;
    padding:18px 0;
    border-top:1px solid var(--hairline);
  }
  .step-row:first-child{border-top:none;}
  .step-num{
    font-family:var(--mono);
    font-size:13px;
    color:var(--text-faint);
    padding-top:2px;
    flex-shrink:0;
    width:24px;
  }
  .step-body h3{
    font-family:var(--mono);
    text-transform:uppercase;
    letter-spacing:0.08em;
    font-size:13px;
    font-weight:600;
    margin:0 0 6px;
    color:var(--teal);
  }
  .step-body p{
    margin:0;
    font-size:16px;
    color:var(--text-dim);
  }

  .colab p{font-size:16px; color:var(--text-dim); margin:0 0 12px;}
  .colab strong{color:var(--text); font-weight:600;}

  .hett-card{
    display:block;
    border:1px solid var(--hairline);
    background:var(--panel);
    text-decoration:none;
    overflow:hidden;
    transition:border-color 0.15s ease;
  }
  .hett-card:hover{border-color:var(--amber);}
  .hett-card img{
    display:block;
    width:100%;
    height:auto;
  }
  .hett-card .cap{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:14px 16px;
  }
  .hett-card .cap .label{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--text-faint);
    display:block;
    margin-bottom:4px;
  }
  .hett-card .cap .title{
    font-family:var(--serif);
    font-size:16px;
    color:var(--text);
  }
  .hett-card .cap .arrow{
    font-family:var(--mono);
    color:var(--amber);
    font-size:18px;
    flex-shrink:0;
  }

  .aside{
    font-family:var(--serif);
    font-style:italic;
    font-size:15px;
    color:var(--text-faint);
    border-left:2px solid var(--hairline);
    padding-left:14px;
    margin-top:22px;
  }
  .aside a{color:var(--text-faint); text-decoration-color:var(--hairline);}

  .branch{
    display:flex;
    flex-direction:column;
    gap:2px;
  }
  .branch-link{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:18px 16px;
    background:var(--panel);
    border:1px solid var(--hairline);
    text-decoration:none;
    color:var(--text);
    transition:border-color 0.15s ease, background 0.15s ease;
  }
  .branch-link:hover{
    border-color:var(--amber);
    background:var(--panel-2);
  }
  .branch-link .label{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--text-faint);
    display:block;
    margin-bottom:4px;
  }
  .branch-link .title{
    font-family:var(--serif);
    font-size:17px;
  }
  .branch-link .arrow{
    font-family:var(--mono);
    color:var(--amber);
    font-size:18px;
    flex-shrink:0;
    display:flex;
    align-items:center;
  }
  button.branch-link{
    font:inherit;
    cursor:pointer;
    -webkit-appearance:none;
    appearance:none;
    width:100%;
  }
  .copy-icon svg{display:block; width:18px; height:18px;}
  .copy-confirm{color:var(--teal);}

  footer{
    padding:40px 0 56px;
    border-top:1px solid var(--hairline);
    font-family:var(--mono);
    font-size:11.5px;
    color:var(--text-faint);
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:10px;
  }
  footer a{color:var(--text-faint);}
  footer a:hover{color:var(--amber);}

  @media (max-width:480px){
    .wrap{padding:0 18px;}
    .branch-link{flex-direction:row;}
    h1.headline{ font-size:clamp(24px, 6.6vw, 38px); }
  }
</style>
<!-- Privacy-friendly analytics by Plausible -->
<script async src="https://plausible.io/js/pa-zKSxfIkTUTpFtGNyIhGJP.js"></script>
<script>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
</head>
<body>

<div class="bars"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>

<div class="wrap">

  <header class="slate">
    <div class="header-row">
      <div class="cam">
        <img src="f4f15a06-48f5-4d89-9ed3-e8fdb72ebfa5.jpg" alt="Mark Winterburn, on Portland">
        <span class="tag-label"><span class="dot" aria-hidden="true"></span>Cam 1</span>
        <span class="bracket tl" aria-hidden="true"></span>
        <span class="bracket tr" aria-hidden="true"></span>
        <span class="bracket bl" aria-hidden="true"></span>
        <span class="bracket br" aria-hidden="true"></span>
      </div>
      <div class="lens-strip" aria-hidden="true">
        <div class="strip-line"></div>
        <div class="strip-dots">
          <span class="strip-dot"></span>
          <span class="strip-dot active"></span>
          <span class="strip-dot"></span>
        </div>
        <div class="strip-caps">
          <span class="strip-cap">Machine</span>
          <span class="strip-cap active">Lens</span>
          <span class="strip-cap">Human</span>
        </div>
      </div>
    </div>
    <div class="ident">
      <span class="tally" aria-hidden="true"></span>
      <span>On air</span>
      <span class="timecode">Portland, Dorset</span>
    </div>
    <div class="name">Mark Winterburn</div>
    <h1 class="headline">Founder: CoLab Lens</h1>
    <p class="pivot"><strong>Built to be looked through</strong> — wherever a machine talks to a person, and it matters, the Lens sits between them.</p>
    <div class="scroll-cue" aria-hidden="true">
      <span class="scroll-arrow">↓</span>
    </div>
  </header>

  <section id="moonshot">
    <div class="cue">The moonshot</div>
    <div class="moonshot">
      <div class="label">Timecode: 2030</div>
      <p class="statement">Solve machine to human communication.</p>
      <p class="sub">A standard. Everywhere a system speaks to a person and it matters.</p>
    </div>
  </section>

  <section id="lens">
    <div class="cue">The Lens</div>
    <div class="bio">
      <p>Four disciplines. Five dimensions. A must pass for everything that leaves a machine and touches a human. The reassurance that someone checked, before it reached you.</p>
      <p class="dim">The NHS is the hardest proving ground on earth. That's exactly where he started.</p>
    </div>
    <div class="dims">
      <span class="dim">Tone Gradient</span>
      <span class="dim">Disclosure Readiness</span>
      <span class="dim">Omission Topology</span>
      <span class="dim">Relational Load</span>
      <span class="dim">Temporal Pressure</span>
    </div>
  </section>

  <section id="questions">
    <div class="cue">Questions Mark keeps asking</div>
    <ul class="questions">
      <li>What if support was ridiculously easy to reach?</li>
      <li>What lives in the space before demand?</li>
      <li>Why build for completeness when only utility travels?</li>
      <li>What if the note belonged to the patient before they reached the car?</li>
      <li>What does this look like everywhere, not just here?</li>
    </ul>
  </section>

  <section id="bio">
    <div class="cue">Lower third</div>
    <div class="tags">
      <span class="tag">NHS Primary Care</span>
      <span class="tag">Neighbourhood Health</span>
      <span class="tag">Applied Philosopher</span>
      <span class="tag op">Opsimath</span>
    </div>
    <div class="bio">
      <p>Digital and Transformation Lead across five GP practices and 74,000 patients on the Isle of Portland and in Weymouth — and, before that, over twenty years as a Playout Director for the BBC, Channel 4, ITV and BT Sport, sending live news and sport out across a curved wall of a hundred screens.</p>
      <p class="dim">Different control rooms, same job: separating the signal from the noise.</p>
    </div>
  </section>

  <section id="proof">
    <div class="cue">Proof of concept: Afternote</div>
    <div class="bio">
      <p>Afternote is the Lens at work inside a single conversation — a GP appointment, an assessment, a difficult call. It's your recording, made on your own phone, run through the Lens before anything is kept, and yours to keep afterwards.</p>
    </div>
    <div class="steps">
      <div class="step-row">
        <span class="step-num">01</span>
        <div class="step-body">
          <h3>Ask</h3>
          <p>You ask, out loud, before anything runs. Your consent to receive it, their consent to be recorded — both, every time.</p>
        </div>
      </div>
      <div class="step-row">
        <span class="step-num">02</span>
        <div class="step-body">
          <h3>Listen</h3>
          <p>MyScribe captures the conversation as it happens, in the room, without anyone needing to type.</p>
        </div>
      </div>
      <div class="step-row">
        <span class="step-num">03</span>
        <div class="step-body">
          <h3>Lens</h3>
          <p>The CoLab Lens reads it back through four professional voices — accuracy, practical safety, emotional impact, and coherence and meaning.</p>
        </div>
      </div>
      <div class="step-row">
        <span class="step-num">04</span>
        <div class="step-body">
          <h3>Save</h3>
          <p>What comes out is your Afternote — what happened, what was agreed, what to watch for, what to do next.</p>
        </div>
      </div>
    </div>
    <p class="aside">Also proving the Lens: <a href="https://neighbourhoodsignals.uk" target="_blank" rel="noopener">Neighbourhood Signals</a>, listening at the level of a whole community rather than one conversation at a time.</p>
  </section>

  <section id="colab">
    <div class="cue">Built by</div>
    <div class="colab">
      <p><strong>Neighbourhood CoLab CIC</strong> is four childhood friends from Weymouth and Portland — a nurse, a social worker, a counselling psychologist and an applied philosopher — putting well over a century of frontline experience into deciding what a machine is and isn't allowed to say about a conversation it just heard.</p>
    </div>
  </section>

  <section id="connect">
    <div class="cue">Next</div>
    <div class="branch">
      <a class="branch-link" href="https://www.linkedin.com/in/mark-winterburn/" target="_blank" rel="noopener">
        <span>
          <span class="label">Connect</span>
          <span class="title">Find me on LinkedIn</span>
        </span>
        <span class="arrow">→</span>
      </a>
      <a class="branch-link" href="/demo">
        <span>
          <span class="label">See it working</span>
          <span class="title">Walk through demo: Ask &gt; Listen &gt; Lens &gt; Save</span>
        </span>
        <span class="arrow">→</span>
      </a>
      <button type="button" class="branch-link" id="talk-btn" onclick="copyEmail()">
        <span>
          <span class="label">Talk to me</span>
          <span class="title" id="talk-title">hello@markwinterburn.uk</span>
        </span>
        <span class="arrow copy-icon" id="talk-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="1.5"></rect><path d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"></path></svg>
        </span>
      </button>
    </div>
    <a class="hett-card" href="https://www.hettshow.co.uk/" target="_blank" rel="noopener">
      <img src="hett-2026.png" alt="HETT Show 2026 speaker card for Mark Winterburn, Digital Transformation Lead, Weymouth &amp; Portland PCN, 29–30 September, ExCeL London">
      <span class="cap">
        <span>
          <span class="label">Speaking · 29 September</span>
          <span class="title">HETT 2026 opening panel: Neighbourhood Health, From Framework to Function</span>
        </span>
        <span class="arrow">→</span>
      </span>
    </a>
    <p class="aside">Coming to HETT? Email <a href="mailto:hello@markwinterburn.uk">hello@markwinterburn.uk</a> and I'll look out for you.</p>
  </section>

  <footer>
    <span>This page is a scrollsite made by M.R.Winterburn</span>
    <span>Last rebuilt 11 Aug 2026</span>
    <a href="https://www.linkedin.com/in/mark-winterburn/" target="_blank" rel="noopener">linkedin.com/in/mark-winterburn</a>
  </footer>

</div>

<script>
function copyEmail(){
  var email = "hello@markwinterburn.uk";
  var title = document.getElementById('talk-title');
  var icon = document.getElementById('talk-icon');
  var original = title.textContent;
  var originalIcon = icon.innerHTML;

  function showCopied(){
    title.textContent = "Copied to clipboard";
    title.classList.add('copy-confirm');
    icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"></path></svg>';
    setTimeout(function(){
      title.textContent = original;
      title.classList.remove('copy-confirm');
      icon.innerHTML = originalIcon;
    }, 1800);
  }

  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(email).then(showCopied).catch(function(){ fallbackCopy(email, showCopied); });
  } else {
    fallbackCopy(email, showCopied);
  }
}
function fallbackCopy(text, cb){
  var ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); } catch(e){}
  document.body.removeChild(ta);
  if(cb) cb();
}
</script>

</body>
</html>
